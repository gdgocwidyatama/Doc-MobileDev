        </svg>
        <span>Instagram</span>
      </a>
      <a href="https://www.linkedin.com/company/gdgoc-widyatama" target="_blank" rel="noopener noreferrer" class="comm-btn">
        <svg class="comm-icon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
