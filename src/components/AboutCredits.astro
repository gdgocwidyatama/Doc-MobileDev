        </svg>
        <span>LinkedIn</span>
      </a>
    </div>
  </div>
</div>

<style>
  .about-credits-container {
    width: 100%;
    margin: 3.5rem 0 1.5rem;
    padding: 2.5rem 2rem;
    background-color: var(--m3-surface-container);
    border: none !important;
    outline: none !important;
    border-radius: var(--m3-shape-extra-large, 28px);
  }

  .credits-header {
    text-align: left;
    margin-bottom: 2rem;
  }

  /* Solid preset pill header */
  .credits-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.95rem;
    background-color: var(--m3-surface-container-highest);
    border: none !important;
    outline: none !important;
    border-radius: var(--m3-shape-pill, 9999px);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--m3-on-surface);
    margin-bottom: 0.85rem;
  }

  .credits-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--m3-on-surface);
    margin: 0 0 0.5rem 0 !important;
    line-height: 1.25;
  }

  .credits-subtitle {
    font-size: 0.95rem;
    color: var(--m3-on-surface-variant);
    margin: 0 !important;
    line-height: 1.6;
    max-width: 52rem;
  }

  .credits-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 860px) {
    .credits-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  .credit-card {
    background-color: var(--m3-surface-container-high);
    border: none !important;
    outline: none !important;
    border-radius: 20px;
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .credit-card:hover {
    transform: translateY(-2px);
    background-color: var(--m3-surface-container-highest);
  }

  /* Solid color pill following theme preset - zero blur, zero transparency */
  .credit-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--m3-shape-pill, 9999px);
    border: none !important;
    outline: none !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.15rem;
    background-color: var(--m3-surface-container-highest);
    color: var(--m3-on-surface);
    display: inline-block;
  }

  /* GitHub Avatar Image */
  .credit-avatar-link {
    display: inline-block;
    margin-bottom: 0.85rem;
    line-height: 1;
    border: none !important;
    outline: none !important;
  }

  .credit-avatar-img {
    width: 52px;
    height: 52px;
    border-radius: 50% !important;
    object-fit: cover !important;
    display: block;
    background-color: var(--m3-surface-container-highest);
    border: none !important;
    outline: none !important;
    transition: transform 0.2s ease;
  }

  .credit-card:hover .credit-avatar-img {
    transform: scale(1.05);
  }

  /* Neutral typography - no rainbow colors */
  .credit-card h4 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--m3-on-surface);
    margin: 0 0 0.25rem 0 !important;
    line-height: 1.3;
  }

  .credit-role {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--m3-on-surface-variant);
    margin-bottom: 0.85rem;
  }

  .credit-card p {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--m3-on-surface-variant);
    margin: 0 !important;
  }

  .credit-card code {
    font-size: 0.8rem;
    background-color: var(--m3-surface-container-highest);
    color: var(--m3-on-surface);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: none !important;
  }

  /* Community Links Card */
  .community-links-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.35rem 1.75rem;
    background-color: var(--m3-surface-container-high);
    border: none !important;
    outline: none !important;
    border-radius: 20px;
  }

  .community-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .community-info strong {
    font-size: 0.95rem;
    color: var(--m3-on-surface);
  }

  .community-info span {
    font-size: 0.83rem;
    color: var(--m3-on-surface-variant);
  }

  .community-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .comm-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.15rem;
    border-radius: var(--m3-shape-pill, 9999px);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none !important;
    transition: transform 0.15s ease, background-color 0.15s ease;
    border: none !important;
    outline: none !important;
    background-color: var(--m3-surface-container-highest);
    color: var(--m3-on-surface);
  }

  .comm-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .comm-btn:hover {
    transform: translateY(-2px);
    background-color: var(--m3-surface-container);
    color: var(--m3-on-surface);
  }

  .comm-btn:hover .comm-icon {
    opacity: 1;
  }
</style>
